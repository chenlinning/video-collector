# Video Collector private, non-caching CONNECT egress.
# This listener must never be exposed by a public security-group rule.
pid_filename /run/squid-video-collector.pid
http_port 10.77.0.2:3128
visible_hostname video-collector-egress
httpd_suppress_version_string on

acl us_wireguard_peer src 10.77.0.1/32
acl too_many_connections maxconn 16
acl CONNECT method CONNECT
acl SSL_ports port 443
acl HTTP_ports port 80
acl Safe_ports port 80
acl Safe_ports port 443

# Reject non-public, reserved, documentation, multicast and metadata ranges.
acl blocked_ipv4 dst 0.0.0.0/8
acl blocked_ipv4 dst 10.0.0.0/8
acl blocked_ipv4 dst 100.64.0.0/10
acl blocked_ipv4 dst 127.0.0.0/8
acl blocked_ipv4 dst 169.254.0.0/16
acl blocked_ipv4 dst 172.16.0.0/12
acl blocked_ipv4 dst 192.0.0.0/24
acl blocked_ipv4 dst 192.0.2.0/24
acl blocked_ipv4 dst 192.168.0.0/16
acl blocked_ipv4 dst 198.18.0.0/15
acl blocked_ipv4 dst 198.51.100.0/24
acl blocked_ipv4 dst 203.0.113.0/24
acl blocked_ipv4 dst 224.0.0.0/4
acl blocked_ipv4 dst 240.0.0.0/4
acl blocked_ipv6 dst ::/128
acl blocked_ipv6 dst ::1/128
acl blocked_ipv6 dst fc00::/7
acl blocked_ipv6 dst fe80::/10
acl blocked_ipv6 dst 2001:db8::/32
acl blocked_ipv6 dst ff00::/8

http_access deny !Safe_ports
http_access deny CONNECT !SSL_ports
http_access deny !CONNECT !HTTP_ports
http_access deny to_localhost
http_access deny to_linklocal
http_access deny blocked_ipv4
http_access deny blocked_ipv6
http_access deny !us_wireguard_peer
http_access deny too_many_connections
http_access allow us_wireguard_peer
http_access deny all

# Never retain media responses or request URLs on the domestic server.
cache deny all
# Squid 5 defaults to no disk cache when no cache_dir directive is present.
cache_mem 0 MB
maximum_object_size 0 KB
access_log none
cache_log /dev/null
cache_store_log none

# Conservative starting limits; adjust only after measuring server bandwidth.
delay_pools 1
delay_class 1 2
delay_parameters 1 10485760/20971520 5242880/10485760
delay_access 1 allow us_wireguard_peer
delay_access 1 deny all

connect_timeout 10 seconds
request_timeout 2 minutes
read_timeout 5 minutes
client_lifetime 2 hours
shutdown_lifetime 5 seconds
forwarded_for delete
